@using BLL.Entities
@model IEnumerable<ASP_MVC.Models.Cocktail.CocktailListItem>

@{
	// ViewData["Title"] = "Index";
	bool isConnected = sessionManager.ConnectedUser is not null;
	IEnumerable<Cocktail> VisitedCocktails = sessionManager.VisitedCocktails;

}

@* <partial name="_VisitedCocktailList" model="@VisitedCocktails" /> *@

<h1>🍹 All the best cocktails</h1>

@if(isConnected){
	<p>
		<a asp-action="Create">Create New</a>
	</p>
}


<partial name="_VisitedCocktailList" model='ViewData["VisitedCocktails"]' />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cocktail_Name)
            </th>
            @* <th> *@
            @*     @Html.DisplayNameFor(model => model.Cocktail_Description) *@
            @* </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cocktail_Name)
            </td>
            @* <td> *@
            @*     @Html.DisplayFor(modelItem => item.Cocktail_Description) *@
            @* </td> *@
				<td>
					@Html.ActionLink("Details", "Details", new { id = item.Cocktail_Id }) |
					@if(isConnected){
						<span>@Html.ActionLink("Edit", "Edit", new { id = item.Cocktail_Id }) |</span>
						@Html.ActionLink("Delete", "Delete", new { id = item.Cocktail_Id })
					}
				</td>

            
        </tr>
}
    </tbody>
</table>
