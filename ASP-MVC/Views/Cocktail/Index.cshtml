@model IEnumerable<ASP_MVC.Models.Cocktail.CocktailListItem>

@{
    ViewData["Title"] = "Index";
}

<h1>All the best cocktails</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cocktail_Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cocktail_Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cocktail_Name)
            </td>
            @* <td> *@
            @*     @Html.DisplayFor(modelItem => item.Cocktail_Description) *@
            @* </td> *@
            <td>
					@Html.ActionLink("Edit", "Edit", new { id = item.Cocktail_Id }) |
					@Html.ActionLink("Details", "Details", new { id = item.Cocktail_Id }) |
					@Html.ActionLink("Delete", "Delete", new { id = item.Cocktail_Id })
            </td>
        </tr>
}
    </tbody>
</table>
