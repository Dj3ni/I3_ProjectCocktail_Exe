@using BLL.Entities
@using Common.Repositories

@inject IUserRepository<User> userService

@model ASP_MVC.Models.Cocktail.CocktailCreate

@{
	ViewData["Title"] = "Create";

	// Va être supprimé une fois qu'on va utiliser les sessions
	List<SelectListItem> UserList = userService.GetAll().Select( user => new SelectListItem{
		Value = user.User_Id.ToString(),
		Text = $"{user.First_Name} {user.Last_Name} "
	}).ToList();

	// @foreach (User user in userService.GetAll()){
	// 	new SelectListItem {Value = $"{user.Id.ToString()}", Text = $"{user.First_Name}" };
	// };
}

<h1>Create</h1>

<h4>🍹Add a new awesome cocktail to the collection🍹</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Cocktail_Name" class="control-label"></label>
                <input asp-for="Cocktail_Name" class="form-control" />
                <span asp-validation-for="Cocktail_Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cocktail_Description" class="control-label"></label>
                <input asp-for="Cocktail_Description" class="form-control" />
                <span asp-validation-for="Cocktail_Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cocktail_Instructions" class="control-label"></label>
                <input asp-for="Cocktail_Instructions" class="form-control" />
                <span asp-validation-for="Cocktail_Instructions" class="text-danger"></span>
            </div>
			<div class="form-group"> 
			<input asp-for="Cocktail_Author"  class="form-control" value ="@sessionManager.ConnectedUser?.UserId" hidden/>
			</div>

			@* Test relation table user avant utilisation de la session *@
			@* <div class="form-group">
			@* 	<label asp-for="Cocktail_Author" class="control-label"></label> *@
			@* 	<select asp-for="Cocktail_Author" asp-items="UserList" class="form-control"></select> *@
			@* 	<span asp-validation-for="Cocktail_Author" class="text-danger"></span> *@
			@* </div> *@


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
