@model ASP_MVC.Models.Cocktail.CocktailEditForm

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CocktailEditForm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Cocktail_Name" class="control-label"></label>
                <input asp-for="Cocktail_Name" class="form-control" />
                <span asp-validation-for="Cocktail_Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cocktail_Description" class="control-label"></label>
                <input asp-for="Cocktail_Description" class="form-control" />
                <span asp-validation-for="Cocktail_Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cocktail_Instructions" class="control-label"></label>
                <input asp-for="Cocktail_Instructions" class="form-control" />
                <span asp-validation-for="Cocktail_Instructions" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="Cocktail">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
