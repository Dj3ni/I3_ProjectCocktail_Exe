@using BLL.Entities
@model IEnumerable<ASP_MVC.Models.Cocktail.CocktailListItem>
@{
	// Queue<Cocktail> visitedList = ViewContext.HttpContext.Session.GetString("VisitedCocktails");

}

<h4>Last visited recipes</h4>

@*  if liste vide , ne rien afficher sinon afficher tout cela et remplacer Model par visitedList*@

@if (Model is null || Model.Any())
{
	<p>No recently cocktails consulted</p>
}
else{
	<table class="table">
		<thead>
			<tr>
				<th>
					@Html.DisplayNameFor(model => model.Cocktail_Name)
				</th>
				@* <th> *@
				@*     @Html.DisplayNameFor(model => model.Cocktail_Description) *@
				@* </th> *@
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Cocktail_Name)
					</td>
					@* <td> *@
					@*     @Html.DisplayFor(modelItem => item.Cocktail_Description) *@
					@* </td> *@
				</tr>
			}
		</tbody>
	</table>
}


