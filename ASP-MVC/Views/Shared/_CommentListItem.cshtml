@model IEnumerable<ASP_MVC.Models.Comment.CommentListItem>
@{
	bool isConnected = sessionManager.ConnectedUser is not null;
	bool isCreator = false;
	if (isConnected && Model.Any(model => model.CreatedBy == sessionManager.ConnectedUser.UserId))
	{
		isCreator = true;
	}
	double averageNote = 0;
}


<h4>Comments</h4>

@if (Model is not null && Model.Count() > 0)
{
	int i = 0;
	foreach(int note in Model.Select(model=>model.Note).ToList()){ // C'est un IEnumerable du coup on doit le transformer en liste!pour le parcourir

		averageNote += note;
		i++;
	}
	averageNote = averageNote / i;
	<p>Average note : @averageNote / 5 </p>

	@if (isCreator == false)
	{
		<a asp-action="Create" asp-controller="Comment">Add a new Comment</a>
	}

	<table class="table">
		<tbody>
		
		<thead>
			<tr>
				<th>
						@Html.DisplayNameFor(model => model.Note)
				</th>
				<th>
						@Html.DisplayNameFor(model => model.Title)
				</th>
				<th>
						@Html.DisplayNameFor(model => model.Content)
				</th>
				<th>
						@Html.DisplayNameFor(model => model.Creator)
				</th>
				<th></th>
			</tr>
		</thead>


			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.DisplayFor(modelItem => item.Note) / 5
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Title)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Content)
					</td>
					<td>
						<a asp-action="Details" asp-controller="User" asp-route-id ="@item.CreatedBy">@Html.DisplayFor(modelItem => item.Creator)</a>
					</td>

					@if(isConnected && isCreator){
						<td>
							<span>@Html.ActionLink("Edit", "Edit", new { id = item.Comment_Id }) |</span>
							@Html.ActionLink("Delete", "Delete", new { id = item.Comment_Id })
						</td>					
					}

				</tr>
			}
		</tbody>
	</table>
}
else 
{ 
	<tr>
		<td>
			<p>No comments for now</p>
		</td>
	</tr>
}

